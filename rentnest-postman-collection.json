    {
      "name": "Properties",
      "item": [
        {
          "name": "Get All Properties",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/properties",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"]
            }
          }
        },
        {
          "name": "Get Property By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/properties/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", ":id"]
            }
          }
        },
        {
          "name": "Create Property",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Luxury Apartment\",\n  \"city\": \"Dhaka\",\n  \"rent\": 25000,\n  \"available\": true,\n  \"landlordId\": \"LANDLORD_ID_HERE\",\n  \"categoryId\": \"CATEGORY_ID_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/properties",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"]
            }
          }
        },
        {
          "name": "Update Property",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Apartment\",\n  \"city\": \"Chittagong\",\n  \"rent\": 30000,\n  \"available\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/properties/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties", ":id"]
            }
          }
        },
