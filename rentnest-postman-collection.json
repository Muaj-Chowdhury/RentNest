    },
    {
      "name": "Rental Requests",
      "item": [
        {
          "name": "Get All Rental Requests",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rental-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rental-requests"]
            }
          }
        },
        {
          "name": "Get Rental Request By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rental-requests/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rental-requests", ":id"]
            }
          }
        },
        {
          "name": "Create Rental Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": \"PROPERTY_ID_HERE\",\n  \"tenantId\": \"TENANT_ID_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rental-requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rental-requests"]
            }
          }
        },
        {
          "name": "Update Rental Request Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rental-requests/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rental-requests", ":id", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment Session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rentalRequestId\": \"{{rentalRequestId}}\",\n  \"phone\": \"01711111111\",\n  \"address\": \"Dhaka\",\n  \"city\": \"Dhaka\",\n  \"postcode\": \"1000\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "create"]
            }
          }
        },
        {
          "name": "Get All Payments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"]
            }
          }
        },
        {
          "name": "Get Payment By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/payments/{{paymentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "{{paymentId}}"]
            }
          }
        },
        {
          "name": "Confirm Payment",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/x-www-form-urlencoded"
                }
              ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "tran_id",
                  "value": "{{transactionId}}"
                },
                {
                  "key": "val_id",
                  "value": "{{validationId}}"
                },
                {
                  "key": "status",
                  "value": "VALID"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "confirm"]
            }
          }
        },
        {
          "name": "IPN Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "VALID"
                },
                {
                  "key": "tran_id",
                  "value": "{{transactionId}}"
                },
                {
                  "key": "val_id",
                  "value": "{{validationId}}"
                },
                {
                  "key": "amount",
                  "value": "15000.00"
                },
                {
                  "key": "currency",
                  "value": "BDT"
                },
                {
                  "key": "currency_type",
                  "value": "BDT"
                },
                {
                  "key": "bank_tran_id",
                  "value": "BANK_TRANSACTION_ID"
                },
                {
                  "key": "risk_level",
                  "value": "0"
                },
                {
                  "key": "verify_sign",
                  "value": "{{verifySign}}"
                },
                {
                  "key": "verify_key",
                  "value": "{{verifyKey}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/ipn",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "ipn"]
            }
          }
        },
        {
          "name": "Success Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "VALID"
                },
                {
                  "key": "tran_id",
                  "value": "{{transactionId}}"
                },
                {
                  "key": "val_id",
                  "value": "{{validationId}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/success",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "success"]
            }
          }
        },
        {
          "name": "Failed Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "FAILED"
                },
                {
                  "key": "tran_id",
                  "value": "{{transactionId}}"
                },
                {
                  "key": "verify_sign",
                  "value": "{{verifySign}}"
                },
                {
                  "key": "verify_key",
                  "value": "{{verifyKey}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/fail",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "fail"]
            }
          }
        },
        {
          "name": "Cancelled Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "status",
                  "value": "CANCELLED"
                },
                {
                  "key": "tran_id",
                  "value": "{{transactionId}}"
                },
                {
                  "key": "verify_sign",
                  "value": "{{verifySign}}"
                },
                {
                  "key": "verify_key",
                  "value": "{{verifyKey}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "cancel"]
            }
          }
        }
      ]
    },
