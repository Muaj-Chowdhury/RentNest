model Payment {
  id String @id @default(uuid())

  rentalRequestId String        @unique
  rentalRequest   RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]

  transactionId String          @unique
  provider      PaymentProvider
  gatewaySessionId String?
  gatewayPageUrl   String?
  validationId     String?


  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT") @db.VarChar(3)
  status PaymentStatus @default(PENDING)


  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

model PaymentAttempt {
  id String @id @default(uuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)//relation type is one to many, one payment can have multiple attempts

  transactionId String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("BDT") @db.VarChar(3)
  status        PaymentStatus @default(PENDING)

  gatewaySessionId String?
  gatewayPageUrl   String?
  validationId     String?
  failureReason    String?
  paidAt           DateTime?

  reconciliation PaymentReconciliation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@map("payment_attempts")
}


model PaymentReconciliation {
  id               String                     @id @default(uuid())
  paymentAttemptId String                     @unique
  paymentAttempt   PaymentAttempt             @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  reason           String
  status           PaymentReconciliationStatus @default(REFUND_REQUIRED)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([status])
  @@map("payment_reconciliations")
}
