model Payment {
  id String @id @default(uuid())

  rentalRequestId String        @unique
  rentalRequest   RentalRequest @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  transactionId String          @unique
  provider      PaymentProvider
  gatewaySessionId String?
  gatewayPageUrl   String?
  validationId     String?


  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT") @db.VarChar(3)
  status PaymentStatus @default(PENDING)

  attempts PaymentAttempt[]
  reconciliations PaymentReconciliation[]

  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("payments")
}

model PaymentAttempt {
  id String @id @default(uuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)//relation type is one to many, one payment can have multiple attempts

  transactionId String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("BDT") @db.VarChar(3)
  status        PaymentStatus @default(PENDING)

  gatewaySessionId String?
  gatewayPageUrl   String?
  validationId     String?
  failureReason    String?
  paidAt           DateTime?
  reconciliations  PaymentReconciliation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@map("payment_attempts")
}

model PaymentReconciliation {
  id String @id @default(uuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  attemptId String
  attempt   PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  status       PaymentReconciliationStatus @default(REFUND_REVIEW_REQUIRED)
  reason       String
  // One row per verified gateway charge. A single transaction can be paid
  // more than once (the tenant reopens the same checkout page), so val_id,
  // not the attempt, identifies the charge.
  validationId String  @unique
  amount       Decimal @db.Decimal(10, 2)
  currency     String  @db.VarChar(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([attemptId])
  @@index([paymentId])
  @@index([status])
  @@map("payment_reconciliations")
}
